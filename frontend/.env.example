# STOCKLEDGER Frontend Environment Configuration
#
# In local development:
# Points to local backend API server (default: http://localhost:5000/api/v1)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# In production (e.g. Vercel deployment):
# Set this to your deployed backend URL in the hosting dashboard (e.g. Vercel Environment Variables):
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
