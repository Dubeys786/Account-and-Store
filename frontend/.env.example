# STOCKLEDGER Frontend Environment Configuration

# 1. Preferred Production Backend URL:
# In Netlify Dashboard -> Site Configuration -> Environment Variables:
# Set VITE_API_URL to your deployed production backend server.
# Example: VITE_API_URL=https://stockledger-api.onrender.com
#
# In local development:
VITE_API_URL=http://localhost:5000

# 2. Legacy Base URL (Supported for backwards compatibility):
VITE_API_BASE_URL=http://localhost:5000/api/v1
