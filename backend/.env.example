PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prozen_db?schema=public"
JWT_SECRET="prozen_enterprise_jwt_super_secret_key_2026_secure"
JWT_EXPIRES_IN="1d"
# Allowed frontend origins (comma-separated). In production, include your Netlify site URL if using custom domain.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://your-stockledger.netlify.app"

# Transactional Email / SMTP Configuration
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM="reports@stockledger.com"
EMAIL_FROM_NAME="StockLedger Accounts & Finance"
